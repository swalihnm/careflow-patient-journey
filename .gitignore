# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node
node_modules/
.next/
dist/
build/

# Env / secrets
.env
.env.*
