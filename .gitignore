# Docker / data volumes
pgdata/
*.log

# ML: raw downloaded datasets, trained model artifacts, local MLflow store
ml/data/raw/
ml/mlruns/
ml/artifacts/
# MLflow falls back to creating ./mlruns at the cwd if a tracking URI isn't
# set at call time -- shouldn't happen (mlflow_utils.use_local_tracking sets
# it first), but ignore it defensively so a stray one never gets committed.
/mlruns/

# Synthea (downloaded jar + generated run artifacts, all regenerated by synthea_runner.py)
fhir/seed/synthea/output/
fhir/seed/synthea/*.jar
fhir/seed/synthea/synthea.properties

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude
.claude/settings.local.json
.claude/scheduled_tasks.lock
