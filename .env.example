# Copy this file to `.env` and fill in a real key. `.env` itself is gitignored --
# never commit real credentials. trustcore.gateway picks this up automatically
# via python-dotenv; no code changes needed once it's present.

# One of these enables the LLM-dependent parts of the assistant (free-text
# replies, the LLM red-flag classifier fallback) and the QA judge (Phase 4).
# Everything else in CareFlow (red-flag rules, scope guard, RAG retrieval,
# the FHIR data platform, the ML models) works with none of these set.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_API_KEY=

# Which model trustcore.gateway defaults to for assistant replies / the QA
# judge. Any LiteLLM-recognised model string works; leave unset to use the
# gateway's own default (a small, fast Claude model).
# CAREFLOW_LLM_MODEL=claude-haiku-4-5-20251001

# Ollama Cloud (https://ollama.com) speaks the OpenAI Chat Completions API,
# not Anthropic's/OpenAI's native one -- if OLLAMA_API_KEY is set (and
# neither key above is), the gateway needs an explicit api_base too. This
# project used CAREFLOW_LLM_MODEL=openai/gpt-oss:20b with the base below;
# gpt-oss:20b is a reasoning model, so expect ~15-20s per call, not
# sub-second. A smaller free-tier model (glm-5.3-flash) returned HTTP 402
# (not covered by the free tier) when tried directly -- confirm whatever
# model you pick is actually included in Ollama Cloud's free tier.
# CAREFLOW_LLM_API_BASE=https://ollama.com/v1
